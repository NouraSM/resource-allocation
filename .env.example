# Supabase project credentials (safe to expose in the browser bundle;
# tenant isolation is enforced by Postgres Row Level Security, not by
# keeping this secret).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional AI features. Set ONLY as a Supabase Edge Function secret
# (`supabase secrets set OPENAI_API_KEY=...`) — never in a VITE_ variable,
# which would ship it to the browser. The app runs fully without it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
